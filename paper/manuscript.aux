\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces {Item loadings. The table shows each item of the Mint with its cluster centrality, which is the EGA equivalent (in terms of interpretation) of factor loadings. It also shows how each lower-level cluster is related to higher-order metaclusters. The lower-level clusters are Expulsion Accuracy (ExAc), Relaxation Awareness (RelA), Sexual Arousal Sensitivity (SexS), Cardiorespiratory Confusion (CaCo), Urointestinal Inaccuracy (UrIn), Dermal Hypersensitivity (Derm), Satiety Noticing (Sati), Olfactory Contribution (Olfa), Respiroception (Resp), Cardioception (Card), Gastroception (Gast).}{}}}{11}{figure.caption.21}\protected@file@percent }
\newlabel{fig-three}{{3}{11}{{Item loadings. The table shows each item of the Mint with its cluster centrality, which is the EGA equivalent (in terms of interpretation) of factor loadings. It also shows how each lower-level cluster is related to higher-order metaclusters. The lower-level clusters are Expulsion Accuracy (ExAc), Relaxation Awareness (RelA), Sexual Arousal Sensitivity (SexS), Cardiorespiratory Confusion (CaCo), Urointestinal Inaccuracy (UrIn), Dermal Hypersensitivity (Derm), Satiety Noticing (Sati), Olfactory Contribution (Olfa), Respiroception (Resp), Cardioception (Card), Gastroception (Gast).}{\label {fig-three}}}{figure.caption.21}{}}
