\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces {Summary table of the comparison between interoception questionnaires (Mint, MAIA, BPQ and IAS). For various outcomes included the study, we tested the Mint and Non-Mint dimension that had the strongest link (as a unique predictor). Values in parenthesis represents correlation coefficient for continuous variables and log-odds ratios for binary variables (the occurrence of mental and somatic health conditions). We also compared the predictive performance of regression models including multiple predictors, and present their ranking based on raw predictive power (R2) and BIC, which favours more parsimonious models (with less predictors). Green background indicates an advantage for the Mint, while red backgrounds indicate an advantage for another interoception scale. Orange backgrounds indicate an advantage for the MAIA driven by its emotion-regulation dimensions (Trusting and Not-Worrying).}{}}}{16}{figure.caption.29}\protected@file@percent }
\newlabel{fig-five}{{6}{16}{{Summary table of the comparison between interoception questionnaires (Mint, MAIA, BPQ and IAS). For various outcomes included the study, we tested the Mint and Non-Mint dimension that had the strongest link (as a unique predictor). Values in parenthesis represents correlation coefficient for continuous variables and log-odds ratios for binary variables (the occurrence of mental and somatic health conditions). We also compared the predictive performance of regression models including multiple predictors, and present their ranking based on raw predictive power (R2) and BIC, which favours more parsimonious models (with less predictors). Green background indicates an advantage for the Mint, while red backgrounds indicate an advantage for another interoception scale. Orange backgrounds indicate an advantage for the MAIA driven by its emotion-regulation dimensions (Trusting and Not-Worrying).}{\label {fig-five}}}{figure.caption.29}{}}
